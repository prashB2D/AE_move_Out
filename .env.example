POSTGRES_DB=moveout
POSTGRES_USER=moveout
POSTGRES_PASSWORD=replace-with-a-local-password


THM_BASE_URL=https://dashboard.thehousemonk.com
THM_COUNTRY_CODE=+91
THM_PHONE=replace-with-your-thm-login-phone
THM_PASSWORD=replace-with-your-thm-login-password
# THM email-first lookup: set to false to skip tenant-email search and use society+flat only.
MOVEOUT_THM_EMAIL_LOOKUP=true

# Sent Items gate — skip move-outs already acknowledged in Sent Items.
# true  = check by recipient email (tenant or owner), then name fallback.
# false = skip recipient-email matching and use tenant/owner name matching.
MOVEOUT_SENT_ITEMS_CHECK=true

MOVEOUT_TEST_EMAIL=replace-with-your-test-email
MOVEOUT_DRY_RUN=true
MOVEOUT_DISABLE_TICKETS=true
MOVEOUT_DISABLE_WHATSAPP=true
MOVEOUT_DISABLE_CALENDAR=true

# Optional n8n-engine deployment configuration.
# Configure these before using generated email/WhatsApp content outside dry-run.
MOVEOUT_ENGINE_SERVICE_DESK_EMAIL=
MOVEOUT_ENGINE_RENTAL_EMAIL=
MOVEOUT_ENGINE_ACCOUNTS_EMAIL=
MOVEOUT_ENGINE_RENEWAL_EMAIL=
MOVEOUT_ENGINE_BANK_NAME=
MOVEOUT_ENGINE_BANK_ACCOUNT_NAME=
MOVEOUT_ENGINE_BANK_ACCOUNT_NUMBER=
MOVEOUT_ENGINE_BANK_IFSC=
MOVEOUT_ENGINE_ONEDRIVE_LOCAL_ROOT=
MOVEOUT_ENGINE_ONEDRIVE_WEB_BASE=
MOVEOUT_ENGINE_EMAIL_FOLDER=
MOVEOUT_ENGINE_WHATSAPP_TEST_NUMBER=
# Optional JSON object mapping ticket type names to assigned agent IDs.
MOVEOUT_ENGINE_TICKET_AGENT_IDS={}
MOVEOUT_DEDUP_DB=postgresql://moveout:replace-with-a-local-password@localhost:5432/moveout
MOVEOUT_PROPERTY_DEDUP_DB=postgresql://moveout:replace-with-a-local-password@localhost:5432/moveout

# ---------------------------------------------------------------------------
# WhatsApp notifications (Meta WhatsApp Cloud API)
# Sent right after the 2 immediate emails: "we have sent you an email, please
# check it". Test it alone with:  python -m app.adapters.whatsapp_sender --test owner
# ---------------------------------------------------------------------------
# Master switch. false = only log what would be sent (nothing reaches WhatsApp).
MOVEOUT_WA_ENABLED=false

# From developers.facebook.com > your app > WhatsApp > API Setup.
# Trial: the temporary access token there expires every 24 hours - paste a new
# one when it does. Production: use a permanent System User token instead.
META_WA_ACCESS_TOKEN=replace-with-your-meta-access-token
# "Phone number ID" (NOT the phone number) shown on the same API Setup page.
META_WA_PHONE_NUMBER_ID=replace-with-phone-number-id
META_WA_API_VERSION=v21.0

# TEST MODE: every WhatsApp goes to this number instead of the real owner/tenant.
# With the trial number it must also be added under "To" > Manage phone number
# list in API Setup (Meta allows max 5 verified test recipients).
# Format: country code + number, e.g. 919876543210
MOVEOUT_WA_TEST_NUMBER=
# Production only: leave MOVEOUT_WA_TEST_NUMBER empty AND set this to true to
# message the real owner/tenant numbers from THM.
MOVEOUT_WA_LIVE=false

# Approved message templates (business-started WhatsApp must use a template).
# Until yours are approved, keep hello_world + en_US + empty PARAMS - it is
# Meta's pre-approved sample and works on the trial number.
# Once approved, e.g.:  renewal_offer_owner / renewal_offer_tenant  with LANG=en
MOVEOUT_WA_TEMPLATE_OWNER=hello_world
MOVEOUT_WA_TEMPLATE_TENANT=hello_world
MOVEOUT_WA_TEMPLATE_LANG=en_US
# The template's body variables {{1}}, {{2}}, ... in order, chosen from:
#   name, property, company, subject
# Must match the template exactly (count and order) or Meta rejects it.
# Example for "Hi {{1}}, {{3}} has emailed you about {{2}} - please check it.":
#   MOVEOUT_WA_TEMPLATE_PARAMS=name,property,company
MOVEOUT_WA_TEMPLATE_PARAMS=
# Used for the "company" variable.
MOVEOUT_COMPANY_NAME=Agarwal Estates
